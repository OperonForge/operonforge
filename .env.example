# Analytics — set in Netlify → Site configuration → Environment variables, then redeploy.
# Vite inlines these at BUILD time; changing them requires a new deploy.
# Yandex Metrika: counter number from metrika.yandex.ru (digits only, e.g. 12345678)
# GA4: measurement ID from analytics.google.com (G-XXXXXXXXXX)
VITE_GA_ID=
VITE_YM_ID=
